h in non-invasive health monitoring, providing ADC samples, range maps, and chest displacement signals.</p><p></p><p>Note: The detailed guide for this data set can be found in \"<a href=\"https://doi.org/10.48550/arXiv.2405.12659\" target=\"_blank\">https://doi.org/10.48550/arXiv.2405.12659</a>\". In the case of using it please cite this article.</p>", "funding": "NWO ENW grant", "funding_list": [{"id": null, "uuid": "5485b640-ca3a-4b7d-82b8-0e18e33817e5", "title": "NWO ENW grant", "grant_code": "", "funder_name": "Dutch Research Council", "is_user_defined": null, "url": ""}], "version": 2, "status": null, "size": null, "created_date": "2024-06-18T15:29:10", "modified_date": "2024-06-18T15:43:12", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 11, "name": "CC BY-NC-SA 4.0", "url": "https://creativecommons.org/licenses/by-nc-sa/4.0/"}, "tags": ["mm-wave FMCW Radar", "Heart rate", "Respiratory rate", "Vital sign detection", "Dataset", "TI AWR1642"], "categories": [{"id": 13612, "uuid": "1e31aae4-6cbd-4cf7-8051-50a487e948a2", "title": "Artificial Intelligence and Image Processing", "parent_id": 13611, "parent_uuid": "c78e1734-8680-4846-8bc9-92ba6e9f77ac", "path": "", "source_id": null, "taxonomy_id": null}, {"id": 13636, "uuid": "2c48d8a5-ed44-4822-b8c8-96c9a7c31468", "title": "Electrical and Electronic Engineering", "parent_id": 13630, "parent_uuid": "0b4f83fd-752d-4437-b29d-43075e4ed4cc", "path": "", "source_id": null, "taxonomy_id": null}, {"id": 13615, "uuid": "422035f0-a80a-4415-a2a8-9e4102791dea", "title": "Data Format", "parent_id": 13611, "parent_uuid": "c78e1734-8680-4846-8bc9-92ba6e9f77ac", "path": "", "source_id": null, "taxonomy_id": null}, {"id": 13417, "uuid": "87311ae0-66a7-4aeb-9dd8-5f43a73f1d00", "title": "Health and Support Services", "parent_id": 13415, "parent_uuid": "69b9b98e-319b-487b-845b-bfc77d8fa43a", "path": "", "source_id": null, "taxonomy_id": n